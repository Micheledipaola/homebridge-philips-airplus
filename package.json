{
  "name": "homebridge-philips-airplus",
  "displayName": "Philips Air+",
  "version": "0.3.0",
  "description": "Homebridge plugin for Philips Air+ / PureProtect air purifiers via the Philips (Versuni) cloud — the same MQTT protocol used by the Air+ app and Google Home.",
  "main": "src/index.js",
  "license": "MIT",
  "keywords": [
    "homebridge-plugin",
    "philips",
    "air purifier",
    "air+",
    "airplus",
    "versuni",
    "homekit"
  ],
  "engines": {
    "node": "^18.17.0 || ^20.9.0 || ^22 || ^24",
    "homebridge": "^1.6.0 || ^2.0.0-beta.0"
  },
  "bin": {
    "philips-airplus-login": "bin/philips-airplus-login.js"
  },
  "files": [
    "src",
    "bin",
    "homebridge-ui",
    "config.schema.json",
    "custom_components/philips_airplus/models.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.0.0",
    "js-yaml": "^4.1.0",
    "mqtt": "^5.10.0"
  },
  "devDependencies": {
    "homebridge": "^1.8.0"
  }
}
